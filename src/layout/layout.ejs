<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- PWA Meta tagek, mobilon telepíthető webalkalmazáshoz -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#13476E">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="TársasApp">
    <link rel="apple-touch-icon" href="/images/icon-192x192.png">
    
    <!-- Meta leírások, meta kereséshez szükséges -->
    <meta name="description" content="AI-alapú társasjáték kereső és gyűjteménykezelő alkalmazás">
    <meta name="keywords" content="társasjáték, board game, AI kereső, gyűjtemény">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('header') %>

    <main class="container mt-4">
        <%- body %>
    </main>

    <%- include('footer') %>
    <div class="AISearchFloatingBtn">
        <a href="/aikereso" class="btn btn-primary" title="AI Kereső">
            <i class="bi bi-robot"></i>
            <span>AI Kereső</span>
        </a>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> <!--js script bootstrapes komponensek működéséhez-->

    <!-- PWA Service Worker regisztráció, telepítés működése -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(registration => {
                        console.log('Regisztrálva:', registration.scope);
                    })
                    .catch(error => {
                        console.log('Regisztráció sikertelen:', error);
                    });
            });
        }
        
        // PWA telepítési folyamat kezelése
        let deferredPrompt;
        window.addEventListener('beforeinstallprompt', (e) => {
            console.log('PWA telepítési prompt elérhető');
            e.preventDefault();
            deferredPrompt = e;
        });
        
        window.addEventListener('appinstalled', () => {
            console.log('PWA sikeresen telepítve!');
            deferredPrompt = null;
        });
    </script>
</body>
</html>