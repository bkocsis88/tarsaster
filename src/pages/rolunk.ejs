<section class="text-center py-5 background-gradient-primary">
    <div class="container text-white">
        <i class="bi bi-people-fill mb-3 main-icon"></i>
        <h1 class="display-4 fw-bold mb-3">Rólunk</h1>
        <p class="lead">Ismerj meg minket és a küldetésünket</p>
    </div>
</section>

<section class="container py-5">
    <div class="row mb-5">
        <div class="col-lg-6 mb-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3 rcbg-60 rcbg-bglight">
                            <i class="bi bi-lightbulb-fill text-white display-6-5"></i>
                        </div>
                        <h3 class="mb-0 main-subtitle-color">A Küldetésünk</h3>
                    </div>
                    <p class="text-muted">
                        A TársasApp egy lelkes fejlesztői csapat kezdeményezése, akik hisznek abban, hogy a társasjáték
                        nemcsak szórakozás, hanem közösségépítés is. Célunk, hogy egy helyen gyűjtsük össze a legjobb játékokat,
                        és lehetőséget adjunk a játékosoknak a véleményük megosztására.
                    </p>
                </div>
            </div>
        </div>
        
        <div class="col-lg-6 mb-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3 rcbg-60 rcbg-bgdark">
                            <i class="bi bi-heart-fill text-white display-6-5"></i>
                        </div>
                        <h3 class="mb-0 main-subtitle-color">Amit Kínálunk</h3>
                    </div>
                    <p class="text-muted">
                        Az oldalon böngészhetsz kategóriák szerint, olvashatsz értékeléseket, és akár te is hozzáadhatod a saját
                        kedvenceidet. Így közösen építünk egy olyan közösséget, ahol a társasjáték iránti szeretet összehoz minket.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mb-5">
        <h2 class="mb-4 main-subtitle-color">Értékeink</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="p-4">
                    <div class="mb-3">
                        <i class="bi bi-shield-check secondary-subtitle-color display-5"></i>
                    </div>
                    <h5 class="fw-bold main-subtitle-color">Megbízhatóság</h5>
                    <p class="text-muted">Pontos és hiteles információkat nyújtunk minden társasjátékról.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4">
                    <div class="mb-3">
                        <i class="bi bi-people main-subtitle-color display-5"></i>
                    </div>
                    <h5 class="fw-bold main-subtitle-color">Közösség</h5>
                    <p class="text-muted">Összekapcsoljuk a játékosokat és építjük a közösséget.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4">
                    <div class="mb-3">
                        <i class="bi bi-stars secondary-subtitle-color display-5"></i>
                    </div>
                    <h5 class="fw-bold main-subtitle-color">Innováció</h5>
                    <p class="text-muted">AI-alapú technológiával segítjük a játékfelismerést.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row text-center mb-5 py-4 background-gradient-lightgrey rounded-15">
        <div class="col-md-4 mb-3 mb-md-0">
            <div class="p-3">
                <h2 class="display-4 fw-bold secondary-subtitle-color">100+</h2>
                <p class="text-muted mb-0">Társasjáték</p>
            </div>
        </div>
        <div class="col-md-4 mb-3 mb-md-0">
            <div class="p-3">
                <h2 class="display-4 fw-bold main-subtitle-color">50+</h2>
                <p class="text-muted mb-0">Felhasználó</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3">
                <h2 class="display-4 fw-bold secondary-subtitle-color">∞</h2>
                <p class="text-muted mb-0">Lehetőség</p>
            </div>
        </div>
    </div>

    <div class="text-center">
        <div class="card border-0 shadow-sm mx-auto max-w-600">
            <div class="card-body p-5">
                <i class="bi bi-envelope-fill mb-3 secondary-subtitle-color display-5"></i>
                <h3 class="mb-3 main-subtitle-color">Vedd fel velünk a kapcsolatot!</h3>
                <p class="text-muted mb-4">
                    Ha kérdésed, ötleted vagy visszajelzésed van, írj nekünk bizalommal!
                </p>
                <a href="mailto:tarsaster2025@gmail.com" class="btn btn-primary btn-lg">
                    <i class="bi bi-envelope me-2"></i>tarsaster2025@gmail.com
                </a>
            </div>
        </div>
    </div>
</section>

<section class="py-5 text-center background-gradient-primary-revese">
    <div class="container text-white">
        <h2 class="mb-3">Csatlakozz a közösségünkhöz!</h2>
        <p class="lead mb-4">Légy részese a társasjáték szerelmeseinek növekvő közösségének.</p>
        <% if (!session.userId) { %>
            <a href="/regisztracio" class="btn btn-light btn-lg me-2">
                <i class="bi bi-person-plus me-2"></i>Regisztráció
            </a>
            <a href="/belepes" class="btn btn-outline-light btn-lg">
                <i class="bi bi-box-arrow-in-right me-2"></i>Belépés
            </a>
        <% } else { %>
            <a href="/tarsasjatekok" class="btn btn-light btn-lg">
                <i class="bi bi-grid-3x3-gap me-2"></i>Fedezd fel a játékokat
            </a>
        <% } %>
    </div>
</section>