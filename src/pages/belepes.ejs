<div class="container loginbox">
    <div class="d-flex justify-content-center">
        <h1 class="mb-5">Belépés</h1>
    </div>
    <div class="d-flex justify-content-center">
        <p class="lead">Kérjük, add meg a belépési adataidat.</p>
    </div>
    <form id="loginForm">
      <div class="mb-3">
        <label for="emailInput" class="form-label">E-mail</label>
        <input type="email" class="form-control" id="emailInput" placeholder="Add meg az e-mail címed" >   
      </div>
      <div class="mb-3">
        <label for="passwordInput" class="form-label">Jelszó</label>
        <input type="password" class="form-control" id="passwordInput" placeholder="Add meg a jelszavad">
      </div>
      <div class="d-flex justify-content-center">
          <button type="submit" class="btn btn-primary">Belépés</button>
      </div>
       
    </form>
    <div class="d-flex justify-content-center">
        <p class="lead">Vagy, ha még nincs fiókod, regisztrálj</p>
    </div>
    <div class="d-flex justify-content-center">
          <button id="btn_registration" type="button" class="btn btn-secondary">Regisztráció</button>
      </div>
    <div class="d-flex justify-content-center">
        <p class="lead">Elfelejtetted a jelszavad?</p>
    </div>
    <div class="d-flex justify-content-center">
          <button id="btn_forgotPassword" type="button" class="btn btn-secondary">Elfelejtettem a jelszavam!</button>
      </div>
</div>
<script src="/js/login.js"></script>