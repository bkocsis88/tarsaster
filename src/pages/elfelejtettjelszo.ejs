<div class="container registrationbox">
    <div class="d-flex justify-content-center">
        <h1 class="mb-5">Elfelejtett jelszó</h1>
    </div>
    <div class="d-flex justify-content-center">
        <p class="lead">Ha elfelejtetted a jelszavad, add meg az e-mail címed, és a további teendőkről e-mailben értesítünk.</p>
    </div>
    <form id="ForgetPasswordForm">
        <div class="mb-3">
            <label for="email" class="form-label">E-mail cím</label>
            <input type="email" class="form-control" id="email" placeholder="E-mail cím">
        </div>
        <div class="d-flex justify-content-center">
            <button type="submit" class="btn btn-primary" id="btn_forgetPassword">Új jelszót kérek!</button>
        </div>
    </form>
</div>
<script src="/js/forgetpassword.js"></script>