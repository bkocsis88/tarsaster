<div class="container modifygamebox">
    <div class="d-flex justify-content-center">
        <h1 class="mb-5">Felhasználó szerkesztő</h1>
    </div>
    <div class="d-flex justify-content-center">
        <p class="lead">Ezen a felületen tudod szerkeszteni a felhasználó jogosultságát.</p>
    </div>
    <form id="ModifyUserForm">
        <input type="hidden" id="userId" value="<%= userId %>">
        <div class="mb-3">
            <label for="nameInput" class="form-label">Felhasználó név</label>
            <input type="text" readonly class="form-control" id="nameInput" placeholder="Felhasználó neve.">
        </div>
        <div class="mb-3">
            <label for="emailInput" class="form-label">E-mail</label>
            <input type="text" readonly class="form-control" id="emailInput" placeholder="Felhasználó e-mail címe">
        </div>
        <div class="mb-3">
            <label for="roleInput" class="form-label">Jogosultság</label>
            <select id="roleInput" class="form-control">
                <option value="admin">Admin</option>
                <option value="user">User</option>
            </select>
        </div>
        <div class="d-flex justify-content-center">
            <button type="submit" class="btn btn-primary m-2">Mentés</button>
            <button type="button" class="btn btn-danger m-2" id="btn_cancel">Mégse</button>
        </div>
    </form>
</div>
<script src="/js/userszerkeszto.js"></script>